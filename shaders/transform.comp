#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Structure to define the NURBS surface
struct NurbsSurface {
    uint degreeU;
    uint degreeV;
    uint numControlPointsU;
    uint numControlPointsV;
    float uMin;
    float uMax;
    float vMin;
    float vMax;
};

struct Vertex {
    vec3 position;
    vec3 normal;
    vec2 uv;
};

// Set grid resolution using push constants
layout(push_constant) uniform PushConstants {
    uint numU;
    uint numV;
} pc;

// Binding 0 - surface structure
layout(std430, binding = 0) readonly buffer SurfaceBuffer {
    NurbsSurface surface;
};

// Binding 1 - knots in the u-direction
layout(std430, binding = 1) readonly buffer KnotsUBuffer {
    float knotsU[];
};

// Binding 2 - knots in the u-direction
layout(std430, binding = 2) readonly buffer KnotsVBuffer {
    float knotsV[];
};

// Binding 3 - control points and weights (flattened)
layout(std430, binding = 3) readonly buffer ControlPointsBuffer {
    vec4 controlPointsW[];
};

// Binding 4: Output vertex data
layout(std430, binding = 5) writeonly buffer OutputVertexBuffer {
    Vertex outVertices[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;

    // Check bounds
    if (i >= pc.numU || j >= pc.numV) {
        return;
    }

    float u = mix(surface.uMin, surface.uMax, float(i) / float(pc.numU - 1));
    float v = mix(surface.vMin, surface.vMax, float(j) / float(pc.numV - 1));

    // Access a control point
    // uint cpIndex = vIndex * surface.numControlPointsU + uIndex;
    // vec3 cp = controlPoints[cpIndex];
    // float w = weights[cpIndex];

    vec3 evaluatedPosition = vec3(u, v, 0.0); 
    vec3 evaluatedNormal = vec3(0.0, 0.0, 1.0);

    uint outIndex = j * pc.numU + i;
    
    outVertices[outIndex].position = evaluatedPosition;
    outVertices[outIndex].normal   = evaluatedNormal;
    outVertices[outIndex].uv       = vec2(u, v);
}